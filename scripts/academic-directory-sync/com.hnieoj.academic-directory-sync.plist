<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  每周学院班级同步的 LaunchAgent 示例。
  __PROJECT_DIR__ / __LOG_DIR__ 由 install-launchagent.sh 在安装时替换，
  避免硬编码某个用户的路径。本仓库不自动注册该计划任务。
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.hnieoj.academic-directory-sync</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>__PROJECT_DIR__/scripts/academic-directory-sync/run-directory-sync.sh</string>
    <string>--apply</string>
  </array>
  <key>WorkingDirectory</key>
  <string>__PROJECT_DIR__</string>
  <key>StartCalendarInterval</key>
  <array>
    <dict>
      <key>Weekday</key>
      <integer>0</integer>
      <key>Hour</key>
      <integer>3</integer>
      <key>Minute</key>
      <integer>30</integer>
    </dict>
  </array>
  <key>RunAtLoad</key>
  <false/>
  <key>ProcessType</key>
  <string>Background</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key>
    <string>/usr/local/bin:/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
  </dict>
  <key>StandardOutPath</key>
  <string>__LOG_DIR__/launchagent.out.log</string>
  <key>StandardErrorPath</key>
  <string>__LOG_DIR__/launchagent.err.log</string>
</dict>
</plist>
