  "narrative": {
    "northStar": "延续现有蓝白工作界面",
    "overview": "这是已实现界面的有限记录，不是新的全站视觉方案，也没有单独批准的视觉效果图。实验室以操作（Operate）与阅读（Read）为主：清楚的中文标签、白色面板、蓝色主要动作和可查询的文字状态。继承现有 Semantic UI 与桌面样式。",
    "keyCharacteristics": [],
    "rules": [],
    "dos": [
      "延续现有蓝白 Semantic UI、可见标签、文字状态和清楚的主要动作。",
      "为长标题与纯文本保留换行和断行，为手机表格保留内部横向滚动。"
    ],
    "donts": [
      "把本次实验室布局规则推广成全站重设计。",
      "为状态增加没有文字解释的颜色编码，或用占位符替代字段标签。"
    ]
